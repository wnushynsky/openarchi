{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenArchi",
  "version": "0.1.0",
  "identifier": "com.openarchi.app",
  "build": {
    "beforeDevCommand": "TAURI_DEV_HOST=127.0.0.1 pnpm exec vite --host 127.0.0.1 --port 3100 --strictPort",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://127.0.0.1:3100",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "OpenArchi",
        "width": 1440,
        "height": 960,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": false
  }
}
